# Vite embeds these into the client bundle at build time - never put secrets here
# (a Google OAuth Client ID is a public identifier, safe to ship in the bundle -
# it's not a secret like a client *secret* would be).
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_OAUTH_CLIENT_ID
