# ── Server ────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ───────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?appName=Cluster0/development
# Staging:    mongodb+srv://<user>:<pass>@staging-cluster.mongodb.net/loyalty
# Production: mongodb+srv://<user>:<pass>@prod-cluster.mongodb.net/loyalty

# ── JWT ───────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── QR Code Signing ───────────────────────────────
# Used to HMAC-sign the static identity token embedded in every customer QR.
QR_SIGNING_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Idempotency Keys ──────────────────────────────
# Used to HMAC-sign the server-issued idempotency key returned by
# /scan/identify and /scan/identify-by-slug, validated on /scan/earn.
IDEMPOTENCY_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX

# ── Google OAuth ──────────────────────────────────
# NOT in ENVIRONMENTS.md section 2 - added because google-auth-library needs
# it to verify the ID token audience on POST /auth/google. Get this from the
# Google Cloud Console OAuth client used by the frontend's Identity Services SDK.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

# ── Email (Resend) ────────────────────────────────
RESEND_API_KEY=re_REPLACE_WITH_RESEND_KEY
EMAIL_FROM=noreply@yourdomain.com

# ── CORS ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
# Production: https://your-production-domain.com,https://*.vercel.app

# ── App URL (for email links) ─────────────────────
APP_URL=http://localhost:5173
